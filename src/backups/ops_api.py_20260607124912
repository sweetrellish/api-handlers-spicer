def _action_db_paths_status():
    queue_groups = []
    for title, candidates in [
        ("queue", ops.QUEUE_DB_CANDIDATES),
        ("idempotency", ops.IDEMPOTENCY_DB_CANDIDATES),
        ("audit", ops.AUDIT_DB_CANDIDATES),
    ]:
        entries = []
        for path in ops._discover_existing_db_paths(candidates):
            entry = {
                "path": path,
                "size": os.path.getsize(path),
                "integrity": ops._sqlite_integrity(path),
                "tables": ops._sqlite_table_names(path),
            }
            counts = ops._queue_counts_for_path(path)
            if counts is not None:
                entry["pendingCounts"] = counts
            entries.append(entry)
        queue_groups.append({"group": title, "entries": entries})

    return "DB paths and status loaded.", {
        "dbPath": ops.DB_PATH,
        "auditDb": ops.AUDIT_DB,
        "canonicalQueueDb": ops.CANONICAL_QUEUE_DB,
        "canonicalAuditDb": ops.CANONICAL_AUDIT_DB,
        "canonicalIdempotencyDb": ops.CANONICAL_IDEMPOTENCY_DB,
        "groups": queue_groups,
    }


def _action_backup_db_files():
    targets = []
    for path in [ops.DB_PATH, ops.AUDIT_DB] + ops.IDEMPOTENCY_DB_CANDIDATES:
        absolute = os.path.abspath(path)
        if os.path.exists(absolute) and absolute not in targets:
            targets.append(absolute)

    backed_up = []
    for path in targets:
        dest = ops._backup_file(path)
        backed_up.append({"source": path, "backup": str(dest)})

    return f"Backed up {len(backed_up)} DB file(s).", {"files": backed_up}


def _action_db_integrity():
    targets = []
    for path in ops.QUEUE_DB_CANDIDATES + ops.IDEMPOTENCY_DB_CANDIDATES + ops.AUDIT_DB_CANDIDATES:
        absolute = os.path.abspath(path)
        if os.path.exists(absolute) and absolute not in targets:
            targets.append(absolute)

    rows = []
    for path in targets:
        rows.append({"path": path, "integrity": ops._sqlite_integrity(path)})
    return "SQLite integrity check completed.", {"results": rows}


def _action_consolidate_db(params: dict[str, Any]):
    require_confirm = bool(params.get("confirm", False))
    existing = ops._discover_existing_db_paths(ops.QUEUE_DB_CANDIDATES)

    if not require_confirm:
        return "Preview only. Re-run with confirm=true to consolidate.", {
            "destination": ops.CANONICAL_QUEUE_DB,
            "sources": existing,
        }

    backups = []
    for path in existing:
        if os.path.abspath(path) == os.path.abspath(ops.CANONICAL_QUEUE_DB):
            continue
        backups.append({"source": path, "backup": str(ops._backup_file(path))})

    inserted = ops._consolidate_queue_dbs(ops.CANONICAL_QUEUE_DB, existing)
    return "Queue DB consolidation completed.", {
        "destination": ops.CANONICAL_QUEUE_DB,
        "inserted": inserted,
        "backups": backups,
        "counts": ops._queue_counts_for_path(ops.CANONICAL_QUEUE_DB),
    }


def _action_audit_log(params: dict[str, Any]):
    mode = str(params.get("mode") or "recent")
    ops.ensure_audit_table()

    if mode == "recent":
        with ops.db_connect(ops.AUDIT_DB) as conn:
            rows = conn.execute(
                "SELECT * FROM posted_comments_audit ORDER BY COALESCE(posted_at, 0) DESC, id DESC LIMIT ?",
                (int(params.get("limit", 50)),),
            ).fetchall()
        return "Recent audit rows loaded.", {"rows": [dict(row) for row in rows]}

    if mode == "search":
        term = str(params.get("term") or "").strip()
        if not term:
            raise ValueError("Provide params.term for audit search.")
        with ops.db_connect(ops.AUDIT_DB) as conn:
            rows = conn.execute(
                "SELECT * FROM posted_comments_audit WHERE customer_name LIKE ? ORDER BY COALESCE(posted_at, 0) DESC, id DESC LIMIT 50",
                (f"%{term}%",),
            ).fetchall()
        return "Audit search completed.", {"rows": [dict(row) for row in rows], "term": term}

    if mode == "crosscheck":
        with ops.db_connect(ops.AUDIT_DB) as conn:
            audit_ids = {row[0] for row in conn.execute("SELECT event_id FROM posted_comments_audit").fetchall()}
        posted = ops.fetch_queue(["posted"], limit=5000)
        missing = [item for item in posted if item.get("event_id") not in audit_ids]
        return "Audit cross-check completed.", {"missing": missing, "missingCount": len(missing)}

    if mode == "export":
        out_path = ROOT / f"audit_export_{time.strftime('%Y%m%d_%H%M%S')}.csv"
        with ops.db_connect(ops.AUDIT_DB) as conn:
            rows = conn.execute(
                "SELECT * FROM posted_comments_audit ORDER BY COALESCE(posted_at, 0) ASC, id ASC"
            ).fetchall()
        if not rows:
            return "Audit export skipped because audit DB is empty.", {"rows": 0}
        with open(out_path, "w", newline="", encoding="utf-8") as handle:
            writer = csv.writer(handle)
            writer.writerow(rows[0].keys())
            writer.writerows(rows)
        return "Audit log exported.", {"rows": len(rows), "path": str(out_path)}

    raise ValueError(f"Unsupported audit mode: {mode}")


def _action_restart_services(services: list[str]):
    rows = []
    for service in services:
        ok, output = ops._systemctl("restart", service)
        rows.append({"service": service, "ok": ok, "output": output[:1000]})
    return "Service restart command finished.", {"results": rows}


def _action_worker_journal():
    try:
        result = subprocess.run(
            [
                "journalctl",
                "-u",
                "marketsharp_queue_worker.service",
                "--since",
                "30 min ago",
                "--no-pager",
                "-n",
                "120",
                "--output=cat",
            ],
            capture_output=True,
            text=True,
            timeout=20,
            check=False,
        )
        output = (result.stdout or result.stderr or "").strip()
        return "Worker journal loaded.", {"exitCode": result.returncode, "output": output[-12000:]}
    except Exception as exc:
        return "Worker journal unavailable on this host.", {"error": str(exc)}


def _action_local_health():
    if not ops._HAS_REQUESTS:
        raise ValueError("Python package 'requests' is required on the backend.")

    response = ops._requests.get(ops.HEALTH_URL, timeout=4)
    return "Local health endpoint checked.", {
        "url": ops.HEALTH_URL,
        "statusCode": response.status_code,
        "body": response.text[:500],
    }


def _action_env_summary():
    keys = [
        "MARKETSHARP_MODE",
        "MARKETSHARP_COMPANY_ID",
        "MARKETSHARP_ODATA_URL",
        "FLASK_PORT",
        "PENDING_QUEUE_DB_PATH",
        "MARKETSHARP_UI_BASE_URL",
        "MARKETSHARP_UI_SEARCH_SELECTOR",
        "COMPANYCAM_WEBHOOK_ID",
    ]
    rows = {}
    for key in keys:
        value = os.getenv(key)
        if any(secret_key in key for secret_key in ("KEY", "SECRET", "PASSWORD", "TOKEN")):
            rows[key] = "(set)" if value else "(not set)"
        else:
            rows[key] = value or "(not set)"
    return "Environment summary loaded.", {"values": rows}


def _action_predeploy_check():
    queue_existing = ops._discover_existing_db_paths(ops.QUEUE_DB_CANDIDATES)
    warnings = []
    errors = []

    if len(queue_existing) > 1:
        fingerprints = {ops._queue_db_fingerprint(path) for path in queue_existing}
        if len(fingerprints) > 1:
            warnings.append("Queue DB candidates diverge in content; consolidate before deploy.")

    db_targets = []
    for path in [ops.DB_PATH, ops.AUDIT_DB] + ops.QUEUE_DB_CANDIDATES + ops.IDEMPOTENCY_DB_CANDIDATES + ops.AUDIT_DB_CANDIDATES:
        absolute = os.path.abspath(path)
        if os.path.exists(absolute) and absolute not in db_targets:
            db_targets.append(absolute)

    for path in db_targets:
        integrity = ops._sqlite_integrity(path)
        if integrity != "ok":
            errors.append({"path": path, "integrity": integrity})

    return "Predeploy check completed.", {
        "queueDb": ops.DB_PATH,
        "auditDb": ops.AUDIT_DB,
        "checkedFiles": len(db_targets),
        "warnings": warnings,
        "errors": errors,
        "pass": len(errors) == 0,
    }
