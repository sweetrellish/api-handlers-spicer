ops_bp = Blueprint("ops_api", __name__, url_prefix="/ops")


def _ok(message: str, data: Any | None = None, status: int = 200):
    return jsonify({"success": True, "message": message, "data": data}), status


def _err(message: str, status: int = 400):
    return jsonify({"success": False, "message": message}), status


def _json_safe(value: Any) -> Any:
    if isinstance(value, (str, int, float, bool)) or value is None:
        return value
    if isinstance(value, list):
        return [_json_safe(item) for item in value]
    if isinstance(value, dict):
        return {str(k): _json_safe(v) for k, v in value.items()}
    return str(value)


def _run_python_script(args: list[str], timeout: int = 180) -> dict[str, Any]:
    env = os.environ.copy()
    pythonpath_parts = [str(ROOT), str(ROOT / "src"), str(SCRIPTS_DIR)]
    existing = env.get("PYTHONPATH", "")
    if existing:
        pythonpath_parts.append(existing)
    env["PYTHONPATH"] = os.pathsep.join(pythonpath_parts)

    venv_python = ROOT / ".venv" / "bin" / "python3"
    python_bin = str(venv_python) if venv_python.exists() else sys.executable

    proc = subprocess.run(
        [python_bin, *args],
        cwd=str(ROOT),
        env=env,
        capture_output=True,
        text=True,
        timeout=timeout,
        check=False,
    )
    return {
        "exitCode": proc.returncode,
        "stdout": (proc.stdout or "").strip(),
        "stderr": (proc.stderr or "").strip(),
        "command": [python_bin, *args],
    }


def _get_stats() -> dict[str, int]:
    counts = ops.queue_counts()
    pending = int(counts.get("pending", 0))
    processing = int(counts.get("processing", 0))
    unmatched = int(counts.get("unmatched", 0))
    true_fail = int(counts.get("true_fail", 0))
    posted = int(counts.get("posted", 0))
    return {
        "pending": pending,
        "processing": processing,
        "unmatched": unmatched,
        "trueFail": true_fail,
        "posted": posted,
        "active": pending + processing,
    }


@ops_bp.get("/queue/stats")
def queue_stats():
    return _ok("Queue stats loaded.", _get_stats())


@ops_bp.post("/execute")
def execute_action():
    body = request.get_json(silent=True) or {}
    category_id = str(body.get("categoryId", "")).strip()
    action_id = str(body.get("actionId", "")).strip()
    params = body.get("params") if isinstance(body.get("params"), dict) else {}

    if not category_id or not action_id:
        return _err("categoryId and actionId are required.")

    try:
        message, data = _dispatch_action(category_id, action_id, params)
        return _ok(message, _json_safe(data))
    except ValueError as exc:
        return _err(str(exc), 400)
    except subprocess.TimeoutExpired:
        return _err("Operation timed out.", 504)
    except Exception as exc:
        return _err(f"Operation failed: {exc}", 500)


def _dispatch_action(category_id: str, action_id: str, params: dict[str, Any]):
    key = f"{category_id}.{action_id}"

    if key == "1.1":
        return _action_send_test_webhook(params)
    if key == "1.2":
        run = _run_python_script([str(SCRIPTS_DIR / "recover_missed_comments.py"), "--dry-run"], timeout=600)
        message = "Missed comment catch-up dry-run completed." if run["exitCode"] == 0 else "Missed comment catch-up finished with warnings."
        return message, run
    if key == "1.3":
        return _action_verify_cc_webhook()

    if key == "2.1":
        return "Queue status loaded.", {"stats": _get_stats(), "countsByStatus": ops.queue_counts()}
    if key == "2.2":
        return _action_browse_queue(params)
    if key == "2.3":
        updated = PendingCommentQueue(ops.DB_PATH).requeue_all_unmatched()
        return f"Requeued {updated} unmatched item(s).", {"updated": updated, "stats": _get_stats()}
    if key == "2.4":
        return _action_true_fails(params)
    if key == "2.5":
        return _action_repush_posted(params)
    if key == "2.6":
        return _action_contact_mapping(params)
    if key == "2.7":
        return _action_duplicates(params)
    if key == "2.8":
        return _action_recover_mentions(params)

    if key == "3.1":
        return _action_gclid_report("month")
    if key == "3.2":
        return _action_gclid_report("last_month")
    if key == "3.3":
        return _action_gclid_report("custom", params)
    if key == "3.4":
        return _action_gclid_report("preview", params)
    if key == "3.5":
        return _action_show_latest_csv()
    if key == "3.6":
        return _action_gclid_audit(params)
    if key == "3.7":
        return _action_backend_roster_reconcile()
    if key == "3.8":
        return _action_export_backend_roster()
    if key == "3.9":
        return _action_show_latest_csv()

    if key == "4.1":
        return _action_db_paths_status()
    if key == "4.2":
        return _action_backup_db_files()
    if key == "4.3":
        return _action_db_integrity()
    if key == "4.4":
        return _action_consolidate_db(params)
    if key == "4.5":
        return _action_audit_log(params)
    if key == "4.6":
        _, data = _action_db_paths_status()
        predeploy_msg, predeploy_data = _action_predeploy_check()
        data["predeploy"] = {"message": predeploy_msg, **predeploy_data}
        return "DB status summary loaded.", data

    if key == "5.1":
        return _action_restart_services(ops.WORKER_SERVICES)
    if key == "5.2":
        return _action_restart_services(ops.ALL_SERVICES)
    if key == "5.3":
        return _action_worker_journal()
    if key == "5.4":
        return _action_local_health()
    if key == "5.5":
        return _action_env_summary()
    if key == "5.6":
        run = _run_python_script([str(SCRIPTS_DIR / "health_check.py")], timeout=120)
        message = "Mention worker ops check completed." if run["exitCode"] == 0 else "Mention worker ops check completed with warnings."
        return message, run
    if key == "5.7":
        return _action_predeploy_check()

    raise ValueError(f"Unsupported action: {key}")


def _action_send_test_webhook(params: dict[str, Any]):
    if not ops._HAS_REQUESTS:
        raise ValueError("Python package 'requests' is required on the backend.")

    customer_name = str(params.get("customerName") or "Test Customer")
    comment_text = str(params.get("commentText") or "GUI test comment")

    payload = json.loads(json.dumps(ops._SAMPLE_PAYLOAD))
    payload["data"]["content"] = comment_text
    payload["data"]["id"] = f"gui-test-{int(time.time())}"
    payload["data"]["subject"]["name"] = customer_name
    payload["token"] = os.getenv("COMPANYCAM_WEBHOOK_SECRET", "")

    response = ops._requests.post(ops.WEBHOOK_LOCAL_URL, json=payload, timeout=10)
    message = "Test webhook sent." if response.status_code == 200 else "Test webhook returned non-200 status."
    data = {
        "statusCode": response.status_code,
        "responseText": response.text[:1200],
        "url": ops.WEBHOOK_LOCAL_URL,
    }
    return message, data


def _action_verify_cc_webhook():
    if not ops._HAS_REQUESTS:
        raise ValueError("Python package 'requests' is required on the backend.")

    token = os.getenv("COMPANYCAM_WEBHOOK_TOKEN", "")
    if not token:
        raise ValueError("COMPANYCAM_WEBHOOK_TOKEN is not set in the backend environment.")

    response = ops._requests.get(
        "https://api.companycam.com/v2/webhooks",
        headers={"accept": "application/json", "authorization": f"Bearer {token}"},
        timeout=10,
    )
    if response.status_code != 200:
        return "CompanyCam API returned non-200 status.", {
            "statusCode": response.status_code,
            "body": response.text[:1200],
        }

    body = response.json()
    hooks = body if isinstance(body, list) else body.get("webhooks", [])
    return "Webhook registration loaded.", {"statusCode": 200, "hooks": hooks}


def _action_true_fails(params: dict[str, Any]):
    mode = str(params.get("mode") or "list")
    queue = PendingCommentQueue(ops.DB_PATH)

    if mode == "list":
        return "True-fail items loaded.", {
            "items": ops.fetch_queue(["true_fail"], limit=int(params.get("limit", 100))),
            "stats": _get_stats(),
        }
    if mode == "requeue_all":
        updated = queue.requeue_true_fail()
        return f"Requeued {updated} true_fail item(s).", {"updated": updated, "stats": _get_stats()}
    if mode == "requeue_ids":
        ids = params.get("ids")
        if not isinstance(ids, list) or not ids:
            raise ValueError("Provide params.ids as a non-empty list.")
        cleaned = [int(item) for item in ids]
        updated = queue.requeue_true_fail(queue_ids=cleaned)
        return f"Requeued {updated} selected true_fail item(s).", {"updated": updated, "ids": cleaned, "stats": _get_stats()}
    if mode == "rename_requeue":
        item_id = int(params.get("id", 0))
        new_name = str(params.get("newName") or "").strip()
        if item_id <= 0 or not new_name:
            raise ValueError("Provide params.id and params.newName.")
        ops.queue_update_name(item_id, new_name)
        return f"Renamed and requeued item #{item_id}.", {"id": item_id, "newName": new_name, "stats": _get_stats()}

    raise ValueError(f"Unsupported true-fail mode: {mode}")


def _action_browse_queue(params: dict[str, Any]):
    mode = str(params.get("mode") or "list")
    statuses = params.get("statuses")
    if not isinstance(statuses, list) or not statuses:
        statuses = ["pending", "processing", "unmatched", "true_fail"]
    limit = int(params.get("limit", 100))

    if mode == "list":
        items = ops.fetch_queue(statuses=statuses, limit=limit)
        return "Queue items loaded.", {"items": items, "stats": _get_stats()}

    item_id = int(params.get("id", 0))
    if item_id <= 0:
        raise ValueError("Provide params.id for queue item actions.")

    if mode == "requeue":
        ops.queue_set_status(item_id, "pending", last_error="Manual requeue")
        return f"Queue item #{item_id} requeued.", {"stats": _get_stats()}

    if mode == "rename":
        new_name = str(params.get("newName") or "").strip()
        if not new_name:
            raise ValueError("Provide params.newName for rename action.")
        ops.queue_update_name(item_id, new_name)
        return f"Queue item #{item_id} renamed and requeued.", {"stats": _get_stats()}

    if mode == "delete":
        with ops.db_connect() as conn:
            conn.execute("DELETE FROM pending_comments WHERE id=?", (item_id,))
            conn.commit()
        return f"Queue item #{item_id} deleted.", {"stats": _get_stats()}

    raise ValueError(f"Unsupported queue browse mode: {mode}")


def _action_repush_posted(params: dict[str, Any]):
    mode = str(params.get("mode") or "all")
    now = int(time.time())

    if mode == "list":
        return "Posted queue items loaded.", {"items": ops.fetch_queue(["posted"], limit=int(params.get("limit", 100))), "stats": _get_stats()}

    if mode == "all":
        rows = ops.fetch_queue(["posted"], limit=100000)
        ids = [int(row["id"]) for row in rows]
    elif mode == "ids":
        raw_ids = params.get("ids")
        if not isinstance(raw_ids, list) or not raw_ids:
            raise ValueError("Provide params.ids as a non-empty list.")
        ids = [int(item) for item in raw_ids]
    else:
        raise ValueError(f"Unsupported repush mode: {mode}")

    with ops.db_connect() as conn:
        for item_id in ids:
            conn.execute(
                "UPDATE pending_comments SET status='pending', retry_count=0, last_error='Manual re-push', updated_at=? WHERE id=?",
                (now, item_id),
            )
        conn.commit()

    return f"Requeued {len(ids)} posted item(s).", {"ids": ids, "stats": _get_stats()}


def _action_contact_mapping(params: dict[str, Any]):
    mode = str(params.get("mode") or "list")
    mapping = ops.load_mapping()

    if mode == "list":
        return "Mappings loaded.", {"mappingFile": ops.MAPPING_FILE, "entries": mapping}
    if mode == "upsert":
        key = str(params.get("key") or "").strip()
        url = str(params.get("url") or "").strip()
        if not key or not url:
            raise ValueError("Provide params.key and params.url for mapping upsert.")
        mapping[key] = url
        ops.save_mapping(mapping)
        return "Mapping saved.", {"key": key, "url": url, "count": len(mapping)}
    if mode == "delete":
        key = str(params.get("key") or "").strip()
        if not key:
            raise ValueError("Provide params.key for mapping delete.")
        existed = key in mapping
        if existed:
            del mapping[key]
            ops.save_mapping(mapping)
        return "Mapping delete processed.", {"deleted": existed, "key": key, "count": len(mapping)}
    if mode == "unresolved":
        items = ops.fetch_queue(["pending", "processing", "unmatched"], limit=int(params.get("limit", 200)))
        unresolved = []
        for item in items:
            try:
                payload = json.loads(item.get("payload_json") or "{}")
                proj_id = (payload.get("data") or {}).get("project_id") or (payload.get("data") or {}).get("location_id")
            except Exception:
                proj_id = None
            proj_key = f"project:{proj_id}" if proj_id else None
            name_key = f"name:{(item.get('customer_name') or '').lower()}"
            if not (proj_key and proj_key in mapping) and name_key not in mapping:
                unresolved.append({"item": item, "projectId": proj_id})
        return "Unresolved items loaded.", {"count": len(unresolved), "rows": unresolved}

    raise ValueError(f"Unsupported mapping mode: {mode}")


def _action_duplicates(params: dict[str, Any]):
    with ops.db_connect() as conn:
        dup_event = conn.execute(
            "SELECT event_id, COUNT(*) AS n FROM pending_comments GROUP BY event_id HAVING n > 1"
        ).fetchall()
        dup_text = conn.execute(
            "SELECT comment_text, COUNT(*) AS n FROM pending_comments GROUP BY comment_text HAVING n > 1"
        ).fetchall()

    mode = str(params.get("mode") or "scan")
    if mode == "scan":
        return "Duplicate scan completed.", {
            "duplicateEventIds": [dict(row) for row in dup_event],
            "duplicateCommentTexts": [dict(row) for row in dup_text],
        }

    deleted = 0
    with ops.db_connect() as conn:
        if mode == "cleanup_event_id":
            for row in dup_event:
                max_id = conn.execute(
                    "SELECT MAX(id) FROM pending_comments WHERE event_id=?",
                    (row["event_id"],),
                ).fetchone()[0]
                result = conn.execute(
                    "DELETE FROM pending_comments WHERE event_id=? AND id != ?",
                    (row["event_id"], max_id),
                )
                deleted += int(result.rowcount or 0)
        elif mode == "cleanup_comment_text":
            for row in dup_text:
                max_id = conn.execute(
                    "SELECT MAX(id) FROM pending_comments WHERE comment_text=?",
                    (row["comment_text"],),
                ).fetchone()[0]
                result = conn.execute(
                    "DELETE FROM pending_comments WHERE comment_text=? AND id != ?",
                    (row["comment_text"], max_id),
                )
                deleted += int(result.rowcount or 0)
        else:
            raise ValueError(f"Unsupported duplicate mode: {mode}")
        conn.commit()

    return f"Duplicate cleanup completed. Deleted {deleted} row(s).", {"deleted": deleted, "stats": _get_stats()}


def _action_recover_mentions(params: dict[str, Any]):
