        cmd.append("--apply")
    run = _run_python_script(cmd, timeout=900)
    message = "Tagger mention recovery completed." if run["exitCode"] == 0 else "Tagger mention recovery finished with warnings."
    return message, run


def _month_range(which: str):
    now = time.localtime()
    if which == "month":
        return f"{now.tm_year:04d}-{now.tm_mon:02d}-01"
    year = now.tm_year
    month = now.tm_mon - 1
    if month == 0:
        month = 12
        year -= 1
    return f"{year:04d}-{month:02d}-01"


def _action_gclid_report(mode: str, params: dict[str, Any] | None = None):
    params = params or {}
    script = str(ROOT / "gclid-ms.py")

    if mode == "month":
        since = _month_range("month")
        preview = False
    elif mode == "last_month":
        since = _month_range("last_month")
        preview = False
    elif mode == "custom":
        since = str(params.get("since") or "").strip()
        if not since:
            raise ValueError("Provide params.since as YYYY-MM-DD.")
        preview = False
    elif mode == "preview":
        since = str(params.get("since") or _month_range("month")).strip()
        preview = True
    else:
        raise ValueError(f"Unsupported report mode: {mode}")

    args = [script, "report", "--since", since]
    if preview:
        args.append("--preview")

    run = _run_python_script(args, timeout=1200)
    message = "GCLID report completed." if run["exitCode"] == 0 else "GCLID report completed with warnings."
    return message, run


def _action_show_latest_csv():
