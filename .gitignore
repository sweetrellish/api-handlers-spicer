# Python cache/bytecode
__pycache__/
*.pyc

# Local virtual environment
.venv/

# Local secrets
.env

# SQLite runtime files
*.db
*.sqlite
*.sqlite3

# macOS
.DS_Store

# VS Code workspace settings can be committed selectively if desired
.vscode/*.code-workspace

# Queue UI poster debug screenshots/HTML dumps (saved to logs/debug/ at runtime)
logs/debug/
**/search_box_fail_*.png
**/search_box_fail_*.html
**/notes_tab_fail_*.png
**/notes_tab_fail_*.html

# Browser profile/cache artifacts (never commit)
.marketsharp-profile/
.marketsharp-profile-worker/
scripts/.marketsharp-profile/
scripts/.marketsharp-profile-worker/
